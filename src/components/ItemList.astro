---
import { formatDate, yearOf } from '../lib/format';

export type Item = {
  title: string;
  url: string;
  date: string | null;
  badges?: string[];
  note?: string;
};

interface Props {
  items: Item[];
  /** 年ごとに見出しを付ける(items は日付の降順で渡す) */
  groupByYear?: boolean;
}

const { items, groupByYear = false } = Astro.props;

const groups: [string | null, Item[]][] = [];
for (const item of items) {
  const key = groupByYear ? yearOf(item.date) : null;
  const last = groups.at(-1);
  if (last && last[0] === key) last[1].push(item);
  else groups.push([key, [item]]);
}
---

{
  groups.map(([year, list]) => (
    <>
      {year && <h3 class="year">{year}</h3>}
      <ul class="items">
        {list.map((item) => (
          <li>
            <time class="date" datetime={item.date ?? undefined}>
              {formatDate(item.date)}
            </time>
            <span class="item-body">
              <a href={item.url}>{item.title}</a>
              {item.badges?.map((b) => (
                <span class="badge">{b}</span>
              ))}
              {item.note && <span class="note">{item.note}</span>}
            </span>
          </li>
        ))}
      </ul>
    </>
  ))
}
