---
import Page from '../layouts/Page.astro';
import Tiles from '../components/Tiles.astro';
import { blogSites, posts } from '../data/achievements';
---

<Page title="ブログ" description={`個人のブログ、会社の技術ブログ、Qiita に書いた記事です(${posts.length} 件)。`}>
  <Tiles items={posts.map((p) => ({ ...p, badge: blogSites[p.site].label }))} ratio="1200 / 630" crop />
</Page>
