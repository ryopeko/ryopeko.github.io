---
import Page from '../layouts/Page.astro';
import Tiles from '../components/Tiles.astro';
import { talkServices, talks } from '../data/achievements';
---

<Page title="登壇" description={`カンファレンスや勉強会で発表したスライドです(${talks.length} 件)。`}>
  <Tiles items={talks.map((t) => ({ ...t, badge: talkServices[t.service].label }))} />
  <p class="muted source">
    スライドは
    {
      Object.values(talkServices).map((s, i) => (
        <>
          {i > 0 && ' と '}
          <a href={s.url}>{s.label}</a>
        </>
      ))
    }
    にあります。SlideShare の日付はアップロードした日です。
  </p>
</Page>
