---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { books, contributions, events, ownRepositories, posts, talks } from '../data/achievements';
import { formatYm } from '../lib/format';

const summary = [
  { href: '/talks/', label: '登壇', count: talks.length, unit: '件のスライド' },
  { href: '/blog/', label: 'ブログ', count: posts.length, unit: '本の記事' },
  { href: '/oss/', label: 'OSS', count: contributions.length + ownRepositories.length, unit: 'のリポジトリ' },
  { href: '/books/', label: '書籍', count: books.length, unit: '冊(共著)' },
  { href: '/events/', label: 'イベント', count: events.length, unit: '件の主催・登壇' },
];
---

<Base title={`${profile.name} (@${profile.handle})`} description={`${profile.tagline}。${profile.lead}。`}>
  <header class="hero">
    <p class="handle">@{profile.handle}</p>
    <h1>{profile.name}</h1>
    <p class="tagline">{profile.tagline}</p>
    <p class="lead">{profile.lead}</p>
    <a class="button" href="#contact">お問い合わせ</a>
  </header>

  <main>
    <section id="profile">
      <h2>プロフィール</h2>
      {profile.bio.map((p) => <p>{p}</p>)}
    </section>

    <section id="areas">
      <h2>お手伝いできること</h2>
      <ul class="cards">
        {
          profile.areas.map((a) => (
            <li>
              <h3>{a.title}</h3>
              <p>{a.detail}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="career">
      <h2>経歴</h2>
      <ol class="timeline">
        {
          profile.careers.map((c) => (
            <li>
              <span class="period">
                {formatYm(c.from)}〜{c.to ? formatYm(c.to) : '現在'}
              </span>
              <span class="company">{c.company}</span>
            </li>
          ))
        }
      </ol>
      <p><a href="/career/">各社での役割を見る</a></p>
    </section>

    <section id="achievements">
      <h2>実績</h2>
      <ul class="cards">
        {
          summary.map((s) => (
            <li>
              <h3>
                <a href={s.href}>{s.label}</a>
              </h3>
              <p>
                {s.count} {s.unit}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="contact">
      <h2>連絡先</h2>
      <p>ご相談は、メールか X の DM でお気軽にどうぞ。</p>
      <ul class="contact">
        <li><a href={`mailto:${profile.contact.email}`}>メール: {profile.contact.email}</a></li>
        <li><a href={profile.contact.x} rel="me">X: @{profile.handle}</a></li>
        <li><a href={profile.contact.github} rel="me">GitHub: {profile.handle}</a></li>
      </ul>
    </section>
  </main>
</Base>
