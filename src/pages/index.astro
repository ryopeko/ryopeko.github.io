---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { books, contributions, ownRepositories, posts, skills, talks } from '../data/achievements';
import { formatYm } from '../lib/format';

const summary = [
  { href: '/talks/', label: '登壇', count: talks.length, unit: '件のスライド' },
  { href: '/blog/', label: 'ブログ', count: posts.length, unit: '本の記事' },
  { href: '/oss/', label: 'OSS', count: contributions.length + ownRepositories.length, unit: 'のリポジトリ' },
  { href: '/books/', label: '書籍', count: books.length, unit: '冊(共著)' },
];
---

<Base title={`${profile.name} (@${profile.handle})`} description={`${profile.tagline}。${profile.lead}。`}>
  <header class="hero">
    <p class="handle">@{profile.handle}</p>
    <h1>{profile.name}</h1>
    <p class="tagline">{profile.tagline}</p>
    <p class="lead">{profile.lead}</p>
    <a class="button" href="/contact/">お問い合わせ</a>
  </header>

  <main>
    <section id="profile">
      <h2>プロフィール</h2>
      {profile.bio.map((p) => <p>{p}</p>)}
    </section>

    <section id="areas">
      <h2>お手伝いできること</h2>
      <ul class="cards">
        {
          profile.areas.map((a) => (
            <li>
              <h3>{a.title}</h3>
              <p>{a.detail}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="skills">
      <h2>技術スタック</h2>
      {
        skills.map((c) => (
          <>
            <h3 class="skill-category">{c.category}</h3>
            <ul class="skills">
              {c.items.map((s) => (
                <li>
                  <span class="skill-name">{s.name}</span>
                  {s.years && <span class="skill-years">約 {s.years} 年</span>}
                  {s.frameworks && (
                    <ul class="frameworks">
                      {s.frameworks.map((f) => (
                        <li>
                          {f.name}
                          {f.years && <span class="skill-years">約 {f.years} 年</span>}
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </>
        ))
      }
      <p class="muted note-small">経験年数は、業務で使っていた期間のおおよその合計です。</p>
    </section>

    <section id="career">
      <h2>経歴</h2>
      <ol class="timeline">
        {
          profile.careers.map((c) => (
            <li>
              <span class="period">
                {formatYm(c.from)}〜{c.to ? formatYm(c.to) : '現在'}
              </span>
              <span class="company">{c.company}</span>
            </li>
          ))
        }
      </ol>
      <p><a href="/career/">各社での役割を見る</a></p>
    </section>

    <section id="achievements">
      <h2>実績</h2>
      <ul class="cards">
        {
          summary.map((s) => (
            <li>
              <h3>
                <a href={s.href}>{s.label}</a>
              </h3>
              <p>
                {s.count} {s.unit}
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Base>
